# Both suites, before anything leaves the machine.
#
# Tests run here rather than on pre-commit for two reasons. A series of commits
# costs one test run instead of one each, and the commit hook stays fast enough
# not to be worked around.
#
# This is also the only gate that sees every commit being pushed. A push can carry
# commits made with --no-verify, rebased in from elsewhere, or written on a
# machine where the hooks were never installed, so nothing earlier is a guarantee
# about what is actually going out.

# A git hook inherits whatever PATH git was invoked with, which is not
# necessarily the Node this repository is pinned to. Repeated from pre-commit
# rather than shared, because a hook that depends on another file breaks in a
# way that is hard to read when that file is missing.
node_major="$(node -v 2>/dev/null | sed -n 's/^v\([0-9][0-9]*\).*/\1/p')"
if [ -z "$node_major" ] || [ "$node_major" -lt 20 ]; then
    echo "pre-push: needs Node 20 or newer, found ${node_major:-none}" >&2
    echo "pre-push: the version is pinned in mise.toml; run 'mise use' in this" >&2
    echo "pre-push: repository, or push from a shell where mise is activated" >&2
    exit 1
fi

npm test

# The daemon being down is an environment condition rather than a defect, so it
# does not block the push. Blocking on it would teach the habit of --no-verify,
# and that switch also disables the commit message hook, which is a worse outcome
# than an unverified runtime suite.
#
# It must not skip quietly, though. The runtime suite is the only thing checking
# that the daemon applies what Compose describes, so a silent skip would be false
# confidence rather than a saved minute.
if docker info >/dev/null 2>&1; then
    npm run test:docker
else
    # Report why rather than assuming. A failed `docker info` covers a stopped
    # daemon and a socket the current user cannot open, and saying "not running"
    # for the second sends you to look at Docker Desktop instead of at
    # permissions.
    docker_error="$(docker info 2>&1 >/dev/null | tail -1)"

    echo "" >&2
    echo "pre-push: WARNING - cannot reach the Docker daemon." >&2
    echo "pre-push: ${docker_error}" >&2
    echo "pre-push: the runtime suite did NOT run, so nothing checked that the" >&2
    echo "pre-push: daemon applies what compose.template.yaml describes." >&2
    echo "pre-push: fix the above and run 'npm run test:docker'." >&2
    echo "" >&2
fi
